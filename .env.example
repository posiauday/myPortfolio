# Optional: embed a published Canvas app in the component Detail page.
# Leave blank (or omit this file) and the page renders its honest
# "live Power Apps runtime not connected" state instead.
VITE_POWERAPPS_APP_ID=
VITE_POWERAPPS_TENANT_ID=

# Optional: base path for the built site. Use "/myPortfolio/" for a
# GitHub Pages project site, "/" for a custom domain or user site.
VITE_BASE_PATH=/
